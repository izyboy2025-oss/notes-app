rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Helper for note validation
    function isValidNote(data) {
      return data.keys().hasAll(['id', 'title', 'content', 'createdAt', 'updatedAt', 'userId'])
        && data.keys().size() == 6
        && data.id is string && data.id.size() <= 128
        && data.title is string && data.title.size() <= 500
        && data.content is string && data.content.size() <= 50000
        && data.createdAt is string
        && data.updatedAt is string
        && data.userId == request.auth.uid;
    }

    // Helper for backup metadata validation
    function isValidBackup(data) {
      return data.keys().hasAll(['lastBackupAt'])
        && data.keys().size() == 1
        && data.lastBackupAt is string;
    }

    // Backup metadata rules
    match /backups/{userId} {
      allow get: if isOwner(userId);
      allow create, update: if isOwner(userId) && isValidBackup(incoming());
      
      // Notes subcollection
      match /notes/{noteId} {
        allow list, get: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(noteId) && isValidNote(incoming());
        allow update: if isOwner(userId) && isValidNote(incoming()) && (
          incoming().diff(existing()).affectedKeys().hasOnly(['title', 'content', 'updatedAt'])
        );
        allow delete: if isOwner(userId);
      }
    }
  }
}
